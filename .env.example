# Copy to .env and fill in. NEVER commit .env.

# --- PayPal sandbox (developer.paypal.com -> Apps & Credentials -> Sandbox) ---
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# Sandbox test card used for card-funded orders (no buyer approval needed).
# If declined, generate one: developer.paypal.com -> Testing Tools -> Credit Card Generator
PAYPAL_TEST_CARD_NUMBER=4111111111111111
PAYPAL_TEST_CARD_EXPIRY=2030-12

# --- Anthropic (console.anthropic.com -> API Keys) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max
ANTHROPIC_EFFORT=medium
# "default" = server-side refusal fallback on; "off" to disable
ANTHROPIC_FALLBACKS=default

# --- Agent ---
AGENT_MAX_TURNS=25
REPORTS_DIR=reports
# 1 = use the built-in fake PayPal (no sandbox keys needed; Claude key still needed)
PAYAGENT_FAKE_PAYPAL=0
